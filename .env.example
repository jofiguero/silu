# Plantilla de variables de entorno. Copiar a `.env` en el servidor y rellenar.
# El archivo `.env` real NUNCA se versiona ni se comparte.

# --- Aplicación ---
ENVIRONMENT=prod
# Orígenes permitidos para la web app, en formato JSON.
# Vacío significa que no se permite ningún origen cruzado.
CORS_ORIGINS=[]

# --- Base de datos ---
POSTGRES_USER=silu
POSTGRES_PASSWORD=cambiar-por-una-contrasena-larga-y-aleatoria
POSTGRES_DB=silu
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Web app ---
# Contrasena unica para entrar a la bandeja. Si falta, la API se cierra por
# completo en vez de quedar abierta.
APP_PASSWORD=
# Secreto para firmar la cookie de sesion. Generar con: openssl rand -hex 32
SESSION_SECRET=
SESSION_DAYS=30

# --- Telegram ---
# Token que entrega @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=
# Cadena aleatoria larga. Telegram la devuelve en cada webhook y es lo unico
# que distingue una peticion legitima de cualquiera que adivine la URL.
# Generar con: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Solo este usuario puede crear tickets. Para conocerlo, escribele /id al bot.
TELEGRAM_ALLOWED_USER_ID=

# --- OpenAI ---
# Transcripcion y LLM comparten esta cuenta y este saldo: los creditos se
# cargan en un solo lugar y se descuentan de ahi para ambos.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Transcripcion ---
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TRANSCRIPTION_LANGUAGE=es

# --- LLM ---
LLM_MODEL=gpt-5-nano
# El agente elige acciones sobre tus tickets, lo que exige mas capacidad que
# redactar un resumen. Subirlo a gpt-5-mini si se equivoca eligiendo.
AGENT_MODEL=gpt-5-nano
# Opcionales: solo si algun dia el LLM se mueve a otro gateway que hable el
# protocolo de OpenAI. Vacios, hereda la cuenta de arriba.
LLM_API_KEY=
LLM_BASE_URL=
